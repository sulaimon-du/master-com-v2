# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-48-characters
# Local Postgres (compose maps it to localhost:5432)
DATABASE_URL=postgresql+psycopg://mc:mc@localhost:5432/mastercom
# JSON list of hostnames the app answers to
ALLOWED_HOSTS=["localhost","127.0.0.1"]
LOG_LEVEL=INFO
# Google sign-in (optional). Without both values the Google button is hidden. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
