# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-48-characters
# Local Postgres (compose maps it to localhost:5432)
DATABASE_URL=postgresql+psycopg://mc:mc@localhost:5432/mastercom
# JSON list of hostnames the app answers to
ALLOWED_HOSTS=["localhost","127.0.0.1"]
LOG_LEVEL=INFO
# Google sign-in (optional). Without both values the Google button is hidden. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram bot (optional). The site shows the Telegram buttons when USERNAME (without the @) is set;
# the bot process needs TOKEN. On staging the token lives only on the bot service (R-021).
# The webhook secret and URL are used by the bot process. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Public address of the site, no trailing slash; the bot builds absolute links from it.
SITE_URL=http://localhost:8000
# Header with the visitor's address set by a trusted proxy. Leave empty locally (R-019).
CLIENT_IP_HEADER=
# Uploaded images are stored in this folder (gitignored) unless R2 is configured. UPLOADS_ENABLED
# defaults to true in development and false on staging/production.
MEDIA_ROOT=media
UPLOADS_ENABLED=true
# Cloudflare R2 (optional). With all five set, images go to the bucket instead of MEDIA_ROOT.
# Both URLs must be https://; R2_PUBLIC_URL without a trailing slash. Never commit real values.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
